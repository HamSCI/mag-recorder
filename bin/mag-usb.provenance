binary: mag-usb
version: "0.0.9"

upstream:
  - name: mag-usb
    url:  https://github.com/HamSCI/mag-usb.git
    ref:  v0.0.9-sigmond.1
    sha:  8595c24bb3aa223cb201a50b68b4d4716c085940

build:
  host:        "sigmond-devbox"
  os:          "Debian GNU/Linux 13 (trixie)"
  kernel:      "6.12.101+deb13-cloud-amd64"
  arch:        x86_64
  glibc:       "2.41"
  cmake:       "3.31.6"
  gcc:         "14.2.0"
