binary: mag-usb
version: "0.0.9"

upstream:
  - name: mag-usb
    url:  https://github.com/HamSCI/mag-usb.git
    ref:  v0.0.9-sigmond.2
    sha:  86b201f6524525e31e4f5e595b536eeff3752e8b

build:
  host:        "sigmond-devbox"
  os:          "Debian GNU/Linux 13 (trixie)"
  kernel:      "6.12.101+deb13-cloud-amd64"
  arch:        x86_64
  glibc:       "2.41"
  cmake:       "3.31.6"
  gcc:         "14.2.0"
  date:        2026-09-30T22:29:23Z
  builder:     "build-mag-usb.sh"
  builder_sha: "e157f0f7382cf81d95daa5b86ac86ebccd5b4534"

features:
  websocket:   ON   # -W/-w/-a are silently ignored when OFF
  mqtt:        ON                    # compiled in unconditionally upstream (runtime off by default)

runtime:
  needs_apt:
    - libstdc++6   # ENABLE_WEBSOCKET=ON pulls in the C++ standard library
    - libgcc-s1
    - libssl3      # OpenSSL, linked for MQTT (mqtt_client.c)
  rpath: []
