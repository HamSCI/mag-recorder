[Unit]
Description=mag-recorder (RM3100 magnetometer recorder + PSWS uploader)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=10

# ⛔ NO ADAPTER, NO START.  Without this the unit starts on every boot of a
# station that has no magnetometer and crash-loops to start-limit-hit: mag-usb
# exits "I2C adapter device '/dev/ttyMAG0' not available (error -2)" in about a
# second, Restart=always respawns, and all ten of StartLimitBurst are spent in
# ~74 s.  Measured on WB6CXC-7 2026-10-02 (boot 16:27:21, failed 16:28:35), and
# W3USR-06 was in the identical state — a class defect across dasi2 stations
# built without the sensor.
#
# sigmond already KNOWS this: catalog.toml declares mag-recorder
# `hardware_gated` and harmonize.dormant_reason stops `smd start` from starting
# it.  But that gate guards the smd VERB, and systemd never consults it — the
# unit is WantedBy=multi-user.target with UnitFilePreset=enabled, so boot
# starts it regardless.  This is the guard on systemd's side of that line.
#
# A skipped condition is NOT a failure: systemd logs "Condition check resulted
# in mag-recorder.service being skipped" and leaves the unit clean, which is
# the honest representation of "this station has no magnetometer yet".
#
# ⚠ Pairs with install/99-PololuI2C.rules.  A condition is evaluated only when
# something tries to start the unit, so on its own it would mean "plug the
# sensor in, then reboot".  The udev rule carries SYSTEMD_WANTS so attaching
# the adapter starts the unit immediately — that is what makes this safe.
ConditionPathExists=/dev/ttyMAG0

[Service]
Type=notify
User=magrec
Group=magrec
SupplementaryGroups=dialout

WatchdogSec=30
NotifyAccess=main

# /run/mag-recorder/ is where mag-recorder materializes the mag-usb
# driver TOML (mag-usb-driver.toml) at every daemon start.  systemd
# creates the directory at unit start with owner magrec:magrec and
# the configured mode, and removes it at unit stop -- so the file is
# never persisted across restarts and stays in lockstep with the
# loaded mag-recorder-config.toml.  Without RuntimeDirectoryPreserve
# (default "no"), the cleanup is unconditional.
RuntimeDirectory=mag-recorder
RuntimeDirectoryMode=0750

EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=-/etc/mag-recorder/env

WorkingDirectory=/opt/git/sigmond/mag-recorder

ExecStartPre=+/bin/mkdir -p /var/lib/mag-recorder/upload
ExecStartPre=+/bin/mkdir -p /var/log/mag-recorder
ExecStartPre=+/usr/bin/chown -R magrec:magrec /var/lib/mag-recorder
# sigmond#54: the hs-uploader daemon (user hsupload) ships AND deletes from
# the queue dir, so it needs group write there: setgid group hsupload on the
# dir, 2775.  Runs after the chown -R above (which would otherwise undo it);
# harmless when hs-uploader is not installed (no such group).
ExecStartPre=+/bin/sh -c 'getent group hsupload >/dev/null 2>&1 && chgrp hsupload /var/lib/mag-recorder/upload && chmod 2775 /var/lib/mag-recorder/upload || true'
ExecStartPre=+/usr/bin/chown -R magrec:magrec /var/log/mag-recorder

ExecStart=/opt/git/sigmond/mag-recorder/venv/bin/python3 -m mag_recorder.cli daemon \
    --config /etc/mag-recorder/mag-recorder-config.toml

TimeoutStartSec=60

Restart=always
# EX_CONFIG (78): a config the daemon genuinely cannot run on.  It is NOT
# emitted for unset PSWS identity any more -- the daemon records without it
# and only DELIVERY waits (issue #8); refusing to collect over a missing
# web registration cost W3USR-019 days of data from a healthy sensor.
RestartPreventExitStatus=78
RestartSec=5

# The daemon installs its own FileHandler for the contract-declared
# /var/log/mag-recorder/mag-recorder.log (see cli._add_daemon_file_log), so
# these stay on the journal -- matching REQUIREMENTS.md ("...log + journal")
# and the rest of the suite (psk-recorder, hs-uploader).  Previously this was
# append: + inherit, which sent BOTH streams to the file and left the journal
# empty: an EX_CONFIG exit showed up as a bare "status=78/CONFIG" in
# systemctl with no reason anywhere an operator would look.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mag-recorder

Nice=5
MemoryMax=256M
MemorySwapMax=0

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/mag-recorder /var/log/mag-recorder
ReadOnlyPaths=/etc/mag-recorder /etc/hs-uploader

[Install]
WantedBy=multi-user.target
